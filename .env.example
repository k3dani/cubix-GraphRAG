# Bármilyen OpenAI-kompatibilis végpont (vLLM, Ollama, LM Studio, OpenAI).
# A projekt saját infrastruktúrán futott: vLLM, Qwen3.6-35B-A3B + BAAI/bge-m3.
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=qwen36
LLM_API_KEY=not-needed
# Qwen3 thinking kikapcsolása (chat_template_kwargs); más modellnél: false
LLM_DISABLE_THINKING=true

EMBEDDING_BASE_URL=http://localhost:8001/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=not-needed
EMBEDDING_DIMENSION=1024

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=naive_rag
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=4
